        writer.writerows(reports)
    return Response(
        output.getvalue(),
        mimetype="text/csv",
        headers={"Content-Disposition": "attachment;filename=reports.csv"}
    )

@app.route('/chat', methods=['POST'])
def chat():
    messages = request.json.get('messages', [])
    if MOCK_MODE:
        reply = random.choice(MOCK_RESPONSES)
        return jsonify({"reply": f"[MODE TEST - pas d'API] {reply}"})
    response = client.messages.create(
        model="claude-sonnet-4-5-20250929",
        max_tokens=500,
        system=SYSTEM_PROMPT,
        messages=messages
    )
    return jsonify({"reply": response.content[0].text})

def save_upload(file_key, prefix):
    file = request.files.get(file_key)
    if file and file.filename:
        safe_name = secure_filename(file.filename)
        stored_name = f"{prefix}_{datetime.now().strftime('%Y%m%d%H%M%S')}_{safe_name}"
        file.save(os.path.join(UPLOAD_FOLDER, stored_name))
        return stored_name
    return ""

@app.route('/waitlist', methods=['POST'])
def waitlist_post():
    form = request.form
    id_doc_name = save_upload('id_doc', 'id')
    income_doc_name = save_upload('income_doc', 'income')

    entry = {
        "id": uuid.uuid4().hex,
        "name": form.get("name", ""),
        "contact": form.get("contact", ""),
        "city": form.get("city", ""),
        "bedrooms": form.get("bedrooms", ""),
        "budget": form.get("budget", ""),
        "move_in_date": form.get("move_in_date", ""),
        "adults": form.get("adults", ""),
        "children_under_5": form.get("children_under_5", ""),
        "pets": form.get("pets", ""),
        "smoker": form.get("smoker", ""),
        "has_vehicle": form.get("has_vehicle", ""),
        "vehicle_model": form.get("vehicle_model", ""),
        "vehicle_year": form.get("vehicle_year", ""),
        "employment": form.get("employment", ""),
        "employer": form.get("employer", ""),
        "income": form.get("income", ""),
        "landlord_name": form.get("landlord_name", ""),
        "landlord_contact": form.get("landlord_contact", ""),
        "personalref_name": form.get("personalref_name", ""),
        "personalref_contact": form.get("personalref_contact", ""),
        "reason": form.get("reason", ""),
        "id_doc": id_doc_name,
        "income_doc": income_doc_name,
        "timestamp": datetime.now().isoformat()
    }

    entries = []
    if os.path.exists(WAITLIST_FILE):
        with open(WAITLIST_FILE, "r") as f:
            entries = json.load(f)
    entries.append(entry)
    with open(WAITLIST_FILE, "w") as f:
        json.dump(entries, f, indent=2)

    send_notification(
        f"New waiting list entry: {entry['name']}",
        f"Name: {entry['name']}\nContact: {entry['contact']}\nCity: {entry['city']}\n"
        f"Bedrooms: {entry['bedrooms']}\nBudget: {entry['budget']}\nMove-in: {entry['move_in_date']}"
    )

    return jsonify({"status": "added", "entry": entry})

@app.route('/report', methods=['POST'])
def report_post():
    data = request.json
    entry = {
        "id": uuid.uuid4().hex,
        "name": data.get("name", ""),
        "address": data.get("address", ""),
        "contact": data.get("contact", ""),
        "urgency": data.get("urgency", ""),
        "description": data.get("description", ""),
        "status": "Open",
        "timestamp": datetime.now().isoformat()
    }
    entries = []
    if os.path.exists(REPORTS_FILE):
        with open(REPORTS_FILE, "r") as f:
            entries = json.load(f)
    entries.append(entry)
    with open(REPORTS_FILE, "w") as f:
        json.dump(entries, f, indent=2)

    send_notification(
        f"New issue reported: {entry['urgency']} - {entry['address']}",
        f"Name: {entry['name']}\nAddress: {entry['address']}\nContact: {entry['contact']}\n"
        f"Urgency: {entry['urgency']}\nDescription: {entry['description']}"
    )

    return jsonify({"status": "reported", "entry": entry})

@app.route('/report/status', methods=['POST'])
@requires_auth
def update_report_status():
    data = request.json
    report_id = data.get("id")
    new_status = data.get("status")

    entries = []
    if os.path.exists(REPORTS_FILE):
        with open(REPORTS_FILE, "r") as f:
            entries = json.load(f)

    for entry in entries:
        if entry.get("id") == report_id:
            entry["status"] = new_status
            break

    with open(REPORTS_FILE, "w") as f:
        json.dump(entries, f, indent=2)

    return jsonify({"status": "updated"})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
