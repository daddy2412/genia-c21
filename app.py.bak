@app.route('/')
def home():
    return render_template_string(HTML_PAGE)

@app.route('/admin')
@requires_auth
def admin():
    waitlist = []
    reports = []
    if os.path.exists(WAITLIST_FILE):
        with open(WAITLIST_FILE, "r") as f:
            waitlist = json.load(f)
    if os.path.exists(REPORTS_FILE):
        with open(REPORTS_FILE, "r") as f:
            reports = json.load(f)
    return render_template_string(ADMIN_PAGE, waitlist=waitlist, reports=reports)

@app.route('/uploads/<path:filename>')
@requires_auth
def uploaded_file(filename):
    return send_from_directory(UPLOAD_FOLDER, filename)

@app.route('/export/waitlist')
@requires_auth
def export_waitlist():
    waitlist = []
    if os.path.exists(WAITLIST_FILE):
        with open(WAITLIST_FILE, "r") as f:
            waitlist = json.load(f)
    output = io.StringIO()
    if waitlist:
        writer = csv.DictWriter(output, fieldnames=waitlist[0].keys())
        writer.writeheader()
        writer.writerows(waitlist)
    return Response(
        output.getvalue(),
        mimetype="text/csv",
        headers={"Content-Disposition": "attachment;filename=waitlist.csv"}
    )

@app.route('/export/reports')
@requires_auth
def export_reports():
    reports = []
    if os.path.exists(REPORTS_FILE):
        with open(REPORTS_FILE, "r") as f:
            reports = json.load(f)
    output = io.StringIO()
    if reports:
        writer = csv.DictWriter(output, fieldnames=reports[0].keys())
